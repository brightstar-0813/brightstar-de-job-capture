# Slack Incoming Webhook (optional — skip notify if empty)
SLACK_WEBHOOK_URL=

# Local API (npm start)
PORT=3847

# Capture settings
SEARCH_Q=Data Engineer
# Data Engineer family discovery queries (US remote)
SEARCH_QUERIES=Data Engineer,Senior Data Engineer,Staff Data Engineer,Analytics Engineer,ETL Engineer,Data Platform Engineer,Databricks Engineer,Snowflake Data Engineer
MAX_PAGES=5
SEARCH_EXTRA_PAGES=2
PAGE_SIZE=20
HEADLESS=true
DELAY_MS=800
CRON_SCHEDULE=0 5,17 * * *
RECENT_DAYS=3

# Sources — free HTTP/feeds on by default; Indeed/CareerBuilder off
CAPTURE_DICE=true
CAPTURE_JOBRIGHT=true
CAPTURE_BUILTIN=true
CAPTURE_GREENHOUSE=true
CAPTURE_LEVER=true
CAPTURE_ASHBY=true
CAPTURE_HIMALAYAS=true
CAPTURE_REMOTIVE=true
CAPTURE_JOBICY=true
CAPTURE_REMOTEOK=true
CAPTURE_WWR=true
CAPTURE_JOBGETHER=true
CAPTURE_ARBEITNOW=true
CAPTURE_THEMUSE=true
CAPTURE_WORKINGNOMADS=true
CAPTURE_JOBSPRESSO=true
CAPTURE_SKIPTHEDRIVE=true
CAPTURE_ARC=true
CAPTURE_USAJOBS=true
CAPTURE_ADZUNA=true
CAPTURE_GOOGLEJOBS=true
# Playwright boards (fail soft if Cloudflare blocks)
CAPTURE_ZIPRECRUITER=true
CAPTURE_MONSTER=true
CAPTURE_INDEED=false
CAPTURE_CAREERBUILDER=false

# Optional key-gated APIs (skipped cleanly until set):
# USAJOBS_API_KEY=
# USAJOBS_USER_EMAIL=you@example.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# SERPAPI_KEY=

JOBICY_TAGS=python,data,etl,sql
# ROLE_TITLES / ROLE_PAGES fan-out for Jobspresso (defaults = DE title list)
# ROLE_PAGES=2
# JOBRIGHT_TITLES=Data Engineer,Senior Data Engineer,Analytics Engineer
# JobRight clearance cookies (auto-written by Playwright; no account login)
# JOBRIGHT_AUTH_PATH=download/jobright-auth.json

# Indeed (only if CAPTURE_INDEED=true): npm run indeed:login once
# INDEED_AUTH_PATH=download/indeed-auth.json

# Paths (relative to project root)
DATA_DIR=download
CSV_LATEST_FILE=jobs_latest.csv
# Also written each sync: download/NN_{source}_jobs_latest.csv and NN_workday_jobs_latest.csv
STORE_FILE=store.json
