# Slack Incoming Webhook (optional — skip notify if empty)
SLACK_WEBHOOK_URL=

# Local API (npm start)
PORT=3847

# Capture settings
SEARCH_Q=Data Engineer
# Data Engineer family discovery queries (US remote)
SEARCH_QUERIES=Data Engineer,Senior Data Engineer,Analytics Engineer,ETL Engineer,Data Platform Engineer
MAX_PAGES=5
SEARCH_EXTRA_PAGES=2
PAGE_SIZE=20
HEADLESS=true
DELAY_MS=800
CRON_SCHEDULE=0 5,17 * * *
RECENT_DAYS=3

# Sources (public APIs/feeds on by default; Playwright ZR/Monster off)
CAPTURE_DICE=true
CAPTURE_JOBRIGHT=true
CAPTURE_BUILTIN=true
CAPTURE_GREENHOUSE=true
CAPTURE_LEVER=true
CAPTURE_ASHBY=true
CAPTURE_HIMALAYAS=true
CAPTURE_REMOTIVE=true
CAPTURE_REMOTEOK=true
CAPTURE_WWR=true
CAPTURE_ZIPRECRUITER=false
CAPTURE_MONSTER=false

JOBRIGHT_MAX_PAGES=5
JOBRIGHT_AUTH_PATH=download/jobright-auth.json
JOBRIGHT_TITLES=Data Engineer,Senior Data Engineer,Staff Data Engineer,Lead Data Engineer,Principal Data Engineer,Analytics Engineer,ETL Engineer,Data Platform Engineer,Data Infrastructure Engineer,Big Data Engineer

# Paths (relative to project root)
DATA_DIR=download
CSV_LATEST_FILE=jobs_latest.csv
STORE_FILE=store.json
